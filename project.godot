; Engine configuration file.
; Gully Dash: India Rush - Godot 4
config_version=5

[application]
config/name="Gully Dash: India Rush"
run/main_scene="res://scenes/main.tscn"
config/description="A portrait 2D Indian street endless runner."

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.36, 0.2, 1)
